# ====== WAJIB ======
# Nomor WA UTAMA lu (penerima digest & alert). Format internasional tanpa + / spasi
OWNER_NUMBER=9665XXXXXXXX

# Nomor KEDUA yang dipasang bot (yang masuk ke group-group). Untuk kode pairing.
BOT_NUMBER=9665YYYYYYYY

# ====== OPSIONAL ======
# API key Claude (console.anthropic.com). Kosongkan = bot tetap jalan pakai saringan aturan saja.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# Jam digest otomatis (waktu Saudi), pisahkan koma
DIGEST_TIMES=07:00,19:00
TIMEZONE=Asia/Riyadh

# Lead layanan lu (transport, muthowif, visa, tamis, bagasi) langsung dikirim saat muncul
ALERT_MINE=true

# Simpan pesan penting berapa hari
RETAIN_DAYS=30

# ====== AUTO-REPLY CHAT MASUK (butuh API key Claude) ======
AUTO_REPLY=true
CHAT_MODEL=claude-sonnet-5-5
# Jam bot boleh membalas (waktu Saudi). Contoh 07:00-12:00
REPLY_HOURS=00:00-24:00
REPLY_MAX_PER_CHAT_DAY=25
